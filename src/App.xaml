<Application
    x:Class="HeMiDock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- light mode: the highlight under the mouse was almost white on the white pop-ups – a light grey that is seen
                 (the buttons, the rows of Start and the control center, the icons of the dock) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0C000000" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0C000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- an icon of the dock: no frame, a light background under the mouse -->
            <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="6" />
                <!-- no frame of the keyboard focus on the buttons of the dock and the bar (the window gets the focus when shown) -->
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
