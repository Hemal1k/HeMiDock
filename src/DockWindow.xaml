<Window
    x:Class="HeMiDock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HeMiDock"
    Title="HeMiDock">

    <!-- the parts of the dock in order: Start, search, task view, the apps, Recycle Bin, Downloads |
         virtual desktops, system monitor, drives, keyboard, locks, the notification area, status icons, clock, show desktop.
         Horizontal at the bottom / top, vertical at the left / right edge. -->
    <!-- a transparent background: empty places of the dock take the mouse too (its menu, dropping, dragging the dock) -->
    <Grid x:Name="Root" Padding="6,3" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- the look of the Start button is put in from the settings (logo, grid, own picture) -->
            <Button x:Name="StartButton" Style="{StaticResource DockButton}" Click="Start_Click" RightTapped="Start_RightTapped" />
            <Button x:Name="SearchButton" Style="{StaticResource DockButton}" Click="Search_Click" Visibility="Collapsed">
                <FontIcon x:Name="SearchGlyph" Glyph="&#xE721;" FontSize="18" />
            </Button>
            <Button x:Name="TaskViewButton" Style="{StaticResource DockButton}" Click="TaskView_Click" Visibility="Collapsed">
                <FontIcon x:Name="TaskViewGlyph" Glyph="&#xE7C4;" FontSize="18" />
            </Button>
            <Border x:Name="StartDivider" Width="1" Margin="4,10" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />
            <StackPanel x:Name="Apps" Orientation="Horizontal" Spacing="2" AllowDrop="True" />
            <Button x:Name="BinButton" Style="{StaticResource DockButton}" Click="Bin_Click" RightTapped="Bin_RightTapped" Visibility="Collapsed"
                    AllowDrop="True" DragOver="Bin_DragOver" Drop="Bin_Drop">
                <Image x:Name="BinImage" Width="28" Height="28" />
            </Button>
            <Button x:Name="DownloadsButton" Style="{StaticResource DockButton}" Click="Downloads_Click" Visibility="Collapsed">
                <FontIcon x:Name="DownloadsGlyph" Glyph="&#xE896;" FontSize="20" />
            </Button>
            <Border x:Name="Divider" Width="1" Margin="6,10" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel x:Name="Desktops" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="MonitorText" FontSize="11" VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
            <Button x:Name="UsbButton" Style="{StaticResource DockButton}" Padding="8,6" Click="Usb_Click" Visibility="Collapsed" VerticalAlignment="Center">
                <FontIcon x:Name="UsbGlyph" Glyph="&#xE88E;" FontSize="15" />
            </Button>
            <!-- the letters cut to their own height (Tight): in the middle like the icons beside them -->
            <Button x:Name="LangButton" Style="{StaticResource DockButton}" Padding="8,6" Click="Lang_Click" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="LangText" FontSize="12" FontWeight="SemiBold" TextLineBounds="Tight" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Button>
            <TextBlock x:Name="LocksText" FontSize="11" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed" />
            <StackPanel x:Name="Tray" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
            <Button x:Name="OverflowButton" Style="{StaticResource DockButton}" Padding="7,8" Click="Overflow_Click" Visibility="Collapsed" VerticalAlignment="Center">
                <Path x:Name="OverflowGlyph" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
            <!-- the status icons inside it come from StatusParts (the same as on the top bar) -->
            <Button x:Name="StatusButton" Style="{StaticResource DockButton}" Padding="8,6" Click="Status_Click" />

            <Button x:Name="ClockButton" Style="{StaticResource DockButton}" Padding="8,2" Click="Clock_Click" RightTapped="Clock_RightTapped">
                <!-- the number of new notifications beside the clock (not over it) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ClockStack" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateText" FontSize="11.5" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border x:Name="Badge" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0" Margin="8,0,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Button>
            <!-- show the desktop: the thin strip at the very end, like the taskbar of Windows -->
            <Button x:Name="DesktopButton" Style="{StaticResource DockButton}" Padding="3,10" Click="Desktop_Click" Visibility="Collapsed">
                <Border Width="2" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Button>
        </StackPanel>
        <!-- full width: the notification area, status icons and clock at the far end -->
        <StackPanel x:Name="RowRight" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
</Window>
